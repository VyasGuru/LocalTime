{
  "manifest_version": 3,
  "name": "LocalTime",
  "version": "1.0.7",
  "description": "Shows a conversation participant's local time in LinkedIn messages. Unofficial and not affiliated with LinkedIn.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "tz-data.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
